# Verify vextorglobal.com as a sending domain in Resend, then create a fresh API key.
# Put the real key in .env.local and Vercel Environment Variables, never in this template.
RESEND_API_KEY=re_your_api_key_here
# Optional: override the Resend test sender after verifying your own domain.
